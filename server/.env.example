# Copy to server/.env for local runs. On Railway set these as service variables instead.

# HTTP + websocket port. Railway injects PORT automatically; leave unset there.
PORT=2567

# Where the embedded Postgres (PGlite) keeps its files. On Railway this MUST point
# into a mounted volume (e.g. /data/pglite) or every deploy starts with an empty world.
PGLITE_DIR=/data/pglite

# Google sign-in (optional). Same client id as VITE_GOOGLE_CLIENT_ID on the client.
GOOGLE_CLIENT_ID=

# Moderation queue access (GET /api/mod/reports with header x-mod-token). Unset = endpoint off.
MOD_TOKEN=

# Lobby locals' AI chat (optional). Without a key the bots fall back to canned lines.
KIE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Verbose join/leave logging.
DOVEY_DEBUG=
